{
  "name": "@cognitap/radiant-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Radiant documentation built with Fumadocs Core and MDX",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 3001",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "typecheck": "fumadocs-mdx && NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "preview": "node scripts/serve-docs.mjs",
    "preview:candidate": "node scripts/preview-candidate.mjs",
    "test:smoke": "node scripts/verify-docs.mjs",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test:smoke"
  },
  "dependencies": {
    "@cognitap/radiant": "0.0.3",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2"
}
