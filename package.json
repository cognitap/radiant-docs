{
  "name": "@cognitap/radiant-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Radiant documentation built with Fumadocs Core and MDX",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 3001",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "typecheck": "fumadocs-mdx && NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "preview": "node scripts/serve-docs.mjs",
    "preview:candidate": "node scripts/preview-candidate.mjs",
    "test:deployment": "node scripts/test-deployment.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:site": "node --test tests/site/*.test.ts",
    "check": "pnpm format:check && pnpm lint && pnpm docs:check && pnpm typecheck && node --test tests/workshop-*.test.ts tests/handoff-compiles.test.ts scripts/deployment.test.mjs && pnpm build && pnpm test:site",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@cognitap/radiant": "0.0.36",
    "@tanstack/react-form": "1.33.5",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.152.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2"
}
