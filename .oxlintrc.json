{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y"],
  "categories": { "correctness": "error" },
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    ".source/**",
    ".scratch/**",
    "out/**",
    "output/**"
  ]
}
